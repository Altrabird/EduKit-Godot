; Engine configuration file.
; EduKit — education game asset kit for Godot 4.7

config_version=5

[application]

config/name="EduKit - Education Game Assets"
config/description="Reusable education-themed art, audio, 3D props and GDScript components."
run/main_scene="res://demo/gallery.tscn"
run/main_scene.juara_kuiz="res://games/juara_kuiz/main_menu.tscn"
config/name.juara_kuiz="Juara Kuiz Sekolah"
config/icon.juara_kuiz="res://assets/art/icons/trophy.svg"
run/main_scene.kancil="res://games/kancil/menu.tscn"
config/name.kancil="Kancil & Suku Kata"
config/icon.kancil="res://assets/art/subjects/bahasa_melayu/sang_kancil.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icons/grad_cap.svg"

[autoload]

Audio="*res://kit/autoload/audio.gd"
GameState="*res://kit/autoload/game_state.gd"
Questions="*res://kit/autoload/questions.gd"
Fader="*res://kit/autoload/fader.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://kit/ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
